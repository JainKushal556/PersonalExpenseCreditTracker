CREATE PROCEDURE spGetCategoryWiseCreditReport
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        cat.CategoryName,
        SUM(c.Amount) AS TotalCredit
    FROM tblCredit c
    INNER JOIN tblCreditCategory cat
        ON c.CategoryID = cat.CategoryID
    GROUP BY cat.CategoryName
    ORDER BY TotalCredit DESC;
END;
