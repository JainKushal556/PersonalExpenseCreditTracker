CREATE PROCEDURE spFilterCreditByDateRange
    @StartDate DATE,
    @EndDate DATE
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        c.CreditID,
        c.UserID,
        c.CategoryID,
        cat.CategoryName,
        c.Amount,
        c.Description,
        c.CreditAt
    FROM tblCredit c
    INNER JOIN tblCreditCategory cat
        ON c.CategoryID = cat.CategoryID
    WHERE CAST(c.CreditAt AS DATE) 
          BETWEEN @StartDate AND @EndDate
    ORDER BY c.CreditAt DESC;
END;
GO